{
  "name": "signum-motorven",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=8192 --max-semi-space-size=512 scripts/buildRealDataDump.js && node --max-old-space-size=8192 --max-semi-space-size=512 ./node_modules/vite/bin/vite.js build && node -e \"import('fs').then(fs => fs.copyFileSync('dist/index.html', 'dist/404.html'))\"",
    "lint": "oxlint src scripts",
    "test": "node src/tests/fiscalEngine.test.js && node src/tests/adminSistemaRole.test.js && node src/tests/usersPersistence.test.js && node src/tests/pdfGenerators.test.js",
    "sync:db": "node --max-old-space-size=8192 scripts/buildRealDataDump.js",
    "supabase:local": "node scripts/local-supabase/server.js",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "tunnel": "node scripts/tunnel/start-tunnel.js",
    "tunnel:local": "node -e \"import('fs').then(fs => fs.writeFileSync('.env', 'VITE_SUPABASE_URL=http://localhost:54321\\nVITE_SUPABASE_ANON_KEY=local-free-token\\n'))\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "puppeteer": "^25.5.0",
    "vite": "^8.1.1"
  }
}
